 <% layout("/layouts/boilerplate") %>
<div class="row mt-2">
    <div class="col-8 offset-2">
       
<body>
    <h3>Edit your listing</h3>
    <form method="POST" action="/listings/<%= listing._id %>?_method=PUT" novalidate class="needs-validation"
        enctype="multipart/form-data">
         <div class="mb-3">
                <label for="title" class="form-label">Title</label>
                <input 
                    type="text" 
                    name="listing[title]" 
                    placeholder="Add a catchy title" 
                    class="form-control"
                    value="<%= listing.title %>"
                    required
                >
                <div class="valid-feedback">Title looks good!</div>
         </div>
         <div class="mb-3">
            Original listing image <br>
            <img class="edit-img" src="<%= originalImageURL %>" alt="Current image for <%= listing.title %>">
         </div>
         <div class="mb-3">
            <label for="image" class="form-label">Upload new Image</label>
            <input 
                type="file" 
                name="listing[image]" 
                placeholder="Enter Image URL" 
                class="form-control"
            />
         </div>
         <div class="mb-3">
            <label for="description" class="form-label">Description</label>
            <textarea 
                name="listing[description]" 
                placeholder="Enter Description" 
                class="form-control"
                required
            ><%= listing.description %></textarea>
            <div class="invalid-feedback">Please enter a description.</div>
        </div>
        
        <div class="row">
             <div class="mb-3 col-md-4">
            <label for="country" class="form-label">Country</label>
            <input 
                type="text" 
                name="listing[country]" 
                value="<%= listing.country %>" 
                placeholder="Enter Country" 
                class="form-control"
                required
            >
            <div class="invalid-feedback">Please enter a country name.</div>
        </div>
        <div class="mb-3 col-md-4">
            <label for="price" class="form-label">Price</label>
            <input 
                type="number" 
                name="listing[price]" 
                value="<%= listing.price %>" 
                placeholder="Enter Price" 
                class="form-control"
                step="0.01"
                required
            >
            <div class="invalid-feedback">Please enter a valid price.</div>
        </div>
        </div>
       
        <div class="mb-3">
            <label for="location" class="form-label">Location</label>
            <input 
                type="text" 
                name="listing[location]" 
                value="<%= listing.location %>" 
                placeholder="Enter Location" 
                class="form-control"
                required
            >
            <div class="invalid-feedback">Please enter a location.</div>
        </div>
        
        <button class="btn btn-dark edit-btn mt-3">Edit</button>
    </form>
    
</body>

    </div>
</div>
